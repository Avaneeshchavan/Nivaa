// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Doctor {
  id         String   @id @default(cuid())
  active     Boolean  @default(true)
  supabaseId String   @unique
  email      String   @unique
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  license    String?
  clinicName String?
  address    String?
  phone      String?
  logoUrl    String?

  medicinePreferences DoctorMedicinePref[]
  drafts        RxDraft[]
  patients      Patient[]
  visits        Visit[]
  prescriptions Prescription[]
  templates     DiseaseTemplate[]
}

model Patient {
  id        String    @id @default(cuid())
  doctorId  String
  name      String
  dob       DateTime?
  gender    String?
  phone     String?
  address   String?
  allergies String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  visits        Visit[]
  prescriptions Prescription[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_phone_trgm_idx")
  @@index([doctorId, updatedAt(sort: Desc)])
}

model Visit {
  weightKg      Float?
  bloodPressure String?
  temperatureC  Float?
  spo2          Int?
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  date      DateTime @default(now())
  diagnosis String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]

  @@index([diagnosis(ops: raw("gin_trgm_ops"))], type: Gin, map: "Visit_diagnosis_trgm_idx")
  @@index([doctorId, patientId])
  @@index([patientId, date(sort: Desc)])
}

model Prescription {
  id        String   @id @default(cuid())
  patientId String
  visitId   String?
  doctorId  String
  diagnosis String?
  notes     String?
  medicines Json     @default("[]")
  handwriting Json?
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit?  @relation(fields: [visitId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([diagnosis(ops: raw("gin_trgm_ops"))], type: Gin, map: "Prescription_diagnosis_trgm_idx")
  @@index([doctorId, patientId])
  @@index([visitId, createdAt(sort: Desc)])
}

model Medicine {
  id        String   @id @default(cuid())
  name      String
  system    String   @default("ALLOPATHY")
  generic   String?
  manufacturer String?
  form      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_name_trgm_idx")
  // Presentation uniqueness is a SQL expression index in 202611070005.
  @@index([generic(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_generic_trgm_idx")
}

model DiseaseTemplate {
  id        String   @id @default(cuid())
  doctorId  String
  name      String
  diagnosis String?
  medicines Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

model RxDraft {
  id        String   @id @default(cuid())
  doctorId  String
  key       String
  payload   Json
  updatedAt DateTime @updatedAt
  doctor Doctor @relation(fields: [doctorId], references: [id])
  @@unique([doctorId, key])
}

model AuditLog {
  id         String   @id @default(cuid())
  doctorId   String
  action     String
  resourceId String?
  createdAt  DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
}

model RateLimit {
  key             String   @id
  attempts        Int
  windowStartedAt DateTime @default(now())
}

enum BrandSystem {
  ALLOPATHY
  AYUSH
  OTHER
}
enum BrandSource {
  SEED_CDCI
  SEED_DATASET
  DOCTOR_ADDED
  LEGACY
}
enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  DROPS
  INJECTION
  OINTMENT
  CREAM
  GEL
  INHALER
  POWDER
  SACHET
  OTHER
}
enum MedicineFood {
  BEFORE
  AFTER
  WITH
  ANY
}
model Brand {
  id String @id
  name String
  nameNormalized String
  form MedicineForm
  formText String
  strengthText String?
  manufacturer String?
  packSize String?
  system BrandSystem @default(OTHER)
  isDiscontinued Boolean @default(false)
  discontinuedKnown Boolean @default(false)
  source BrandSource
  sourceId String
  verified Boolean @default(false)
  createdByDoctorId String?
  createdAt DateTime @default(now())
  compositionText String @default("")
  searchText String
  identityKey String @unique
  legacyMedicineId String? @unique
  compositions BrandComposition[]
  aliases BrandAlias[]
  preferences DoctorMedicinePref[]
  @@unique([source, sourceId])
  @@index([nameNormalized(ops: raw("text_pattern_ops"))], map: "Brand_name_prefix_idx")
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "Brand_name_trgm_idx")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}
model Composition {
  id String @id
  genericName String
  strengthText String
  brands BrandComposition[]
}
model BrandComposition {
  brandId String
  compositionId String
  order Int
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  composition Composition @relation(fields: [compositionId], references: [id])
  @@id([brandId, order])
  @@index([compositionId])
}
model BrandAlias {
  brandId String
  alias String
  aliasNormalized String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  @@id([brandId, aliasNormalized])
  @@index([aliasNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
}
model DoctorMedicinePref {
  doctorId String
  brandId String
  useCount Int @default(0)
  lastUsedAt DateTime?
  isFavorite Boolean @default(false)
  defaultPattern String?
  defaultFood MedicineFood?
  defaultDurationDays Int?
  defaultInstruction String?
  defaultDosage String?
  defaultFrequency String?
  defaultDuration String?
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id])
  @@id([doctorId, brandId])
  @@index([doctorId, isFavorite, lastUsedAt(sort: Desc)])
}
