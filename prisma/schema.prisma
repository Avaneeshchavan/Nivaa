// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Doctor {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  license    String?
  clinicName String?
  address    String?
  phone      String?
  logoUrl    String?

  drafts        RxDraft[]
  patients      Patient[]
  visits        Visit[]
  prescriptions Prescription[]
  templates     DiseaseTemplate[]
}

model Patient {
  id        String    @id @default(cuid())
  doctorId  String
  name      String
  dob       DateTime?
  gender    String?
  phone     String?
  address   String?
  allergies String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  visits        Visit[]
  prescriptions Prescription[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_phone_trgm_idx")
  @@index([doctorId, updatedAt(sort: Desc)])
}

model Visit {
  weightKg      Float?
  bloodPressure String?
  temperatureC  Float?
  spo2          Int?
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  date      DateTime @default(now())
  diagnosis String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]

  @@index([diagnosis(ops: raw("gin_trgm_ops"))], type: Gin, map: "Visit_diagnosis_trgm_idx")
  @@index([doctorId, patientId])
}

model Prescription {
  id        String   @id @default(cuid())
  patientId String
  visitId   String?
  doctorId  String
  diagnosis String?
  notes     String?
  medicines Json     @default("[]")
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit?  @relation(fields: [visitId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([diagnosis(ops: raw("gin_trgm_ops"))], type: Gin, map: "Prescription_diagnosis_trgm_idx")
  @@index([doctorId, patientId])
}

model Medicine {
  id        String   @id @default(cuid())
  name      String
  generic   String?
  form      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiseaseTemplate {
  id        String   @id @default(cuid())
  doctorId  String
  name      String
  diagnosis String?
  medicines Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

model RxDraft {
  id        String   @id @default(cuid())
  doctorId  String
  key       String
  payload   Json
  updatedAt DateTime @updatedAt
  doctor Doctor @relation(fields: [doctorId], references: [id])
  @@unique([doctorId, key])
}
